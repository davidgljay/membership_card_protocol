node_modules/
.output/
.output-*/
.nitro/
.wrangler/
dist/
.env
*.local

# Matrix subsystem credentials generated by scripts/generate-matrix-secrets.ts
# (implementation-plan.md Steps 7/7b/7c) — raw key material, never committed.
# Trailing * also covers the Droplet deployment's per-environment copies
# (matrix/secrets.dev/, matrix/secrets.prod/ — see relay/DEPLOYMENT.md's
# "Droplet deployment" section) — a literal `matrix/secrets/` alone does
# NOT match those differently-named directories.
matrix/secrets*/

# Rendered from matrix/homeserver.yaml.template by scripts/render-matrix-config.ts
# (the template, with ${VAR} placeholders, IS committed; this concrete,
# environment-specific rendering is not). Trailing * covers the Droplet
# deployment's matrix/homeserver.dev.yaml / matrix/homeserver.prod.yaml too.
matrix/homeserver*.yaml

# Rendered from matrix/appservice-registration.yaml.template by
# scripts/render-matrix-config.ts (Step 14) — embeds the real as_token/
# hs_token values, so like matrix/homeserver.yaml above, only the .template
# is committed. Trailing * covers the Droplet deployment's
# matrix/appservice-registration.dev.yaml / .prod.yaml too.
matrix/appservice-registration*.yaml

# Local-dev-only compose override (Phase 6 Step 22) — exposes Synapse's
# client API to the host for testing wallet-service outside the Docker
# network. Never the production topology; never committed.
docker-compose.override.yml
