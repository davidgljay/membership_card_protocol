# Synapse homeserver configuration
# Generated for card_protocol wallet-service

server_name: "${MATRIX_SERVER_NAME}"
pid_file: /data/synapse.pid

# Listeners for client and federation traffic
listeners:
  - port: 8008
    bind_addresses:
      - '0.0.0.0'
    type: http
    x_forwarded: true
    resources:
      - names:
          - client
          - federation
        compress: false

# PostgreSQL database configuration. Templated (not hardcoded to the local
# docker-compose synapse-postgres container) so the same template also
# works against an external managed Postgres (e.g. Neon) for the Droplet
# deployment -- see relay/DEPLOYMENT.md's "Droplet deployment" section.
# allow_unsafe_locale: managed Postgres providers generally don't expose
# C collation/ctype at database creation (Synapse's own hard requirement
# otherwise -- see synapse/storage/engines/postgres.py's check_database,
# which raises IncorrectDatabaseSetup without this). This is Synapse's own
# documented override for exactly this case, not a workaround outside its
# support surface. Leave false for local dev, where synapse-postgres is
# already created with --locale=C (docker-compose.yml).
#
# allow_unsafe_locale must be a sibling of `args`, NOT nested inside it --
# confirmed against synapse/config/database.py's DatabaseConnectionConfig
# (self.config = db_config is the whole `database:` block, read directly
# for this key). Nesting it inside `args` instead sends it straight into
# psycopg2.connect() as a literal DSN parameter, which psycopg2 rejects
# outright ("invalid dsn: invalid connection option") -- found live on
# first real render against Neon.
database:
  name: psycopg2
  allow_unsafe_locale: ${MATRIX_DB_ALLOW_UNSAFE_LOCALE}
  args:
    user: ${MATRIX_DB_USER}
    password: ${MATRIX_DB_PASSWORD}
    database: ${MATRIX_DB_NAME}
    host: ${MATRIX_DB_HOST}
    port: ${MATRIX_DB_PORT}
    sslmode: ${MATRIX_DB_SSLMODE}
    cp_min: 5
    cp_max: 10

# Paths
media_store_path: /data/media
signing_key_path: /data/secrets/homeserver.signing.key

# Federation settings
federation_domain_whitelist: []

# Registration disabled; accounts provisioned via Application Service bridge
enable_registration: false

# Statistics reporting disabled
report_stats: false

# Root signing key (loaded separately from above)
# Do NOT include registration_shared_secret here — it comes from the second config file

# Trusted key servers for federation
trusted_key_servers:
  - server_name: matrix.org

# Application Service registrations. wallet-service's shadow-account bridge
# (matrix-implementation-plan.md Phase 4, Step 14) — see
# appservice-registration.yaml.template for the AS's token/namespace config;
# rendered alongside this file by scripts/render-matrix-config.ts.
app_service_config_files:
  - /data/appservice-registration.yaml

# Matrix Policy Module for card-gated room authorization
#
# registry_contract_address MUST be EIP-55 checksummed (mixed-case) --
# web3.py's Web3().eth.contract() hard-rejects an all-lowercase address
# with InvalidAddress ("only accepts checksum addresses"), and this is
# caught at module init time, so a wrong-case address takes Synapse's
# whole startup down, not just this feature. Compute it, don't hand-type
# it -- a manually-cased guess produces a DIFFERENT wrong error
# ("invalid EIP-55 checksum") that looks similar but isn't the same bug:
#   docker run --rm --entrypoint python3 <synapse-image> -c \
#     "from web3 import Web3; print(Web3.to_checksum_address('0x...'))"
# (any image with web3 installed works -- the already-built synapse image
# is the easy one to reach for). Also note this value is rendered into
# this file ONCE at generation time (scripts/render-matrix-config.ts) --
# Synapse reads it from here, not from a live REGISTRY_CONTRACT_ADDRESS
# container env var, so changing the container's env alone (e.g. in
# relay/.env.*.droplet) does nothing until you re-run render-matrix-config.ts
# and replace this file.
modules:
  - module: "matrix_policy_module.module.PolicyModule"
    config:
      arbitrum_rpc_url: "${ARBITRUM_RPC_URL}"
      arbitrum_rpc_ws_url: "${ARBITRUM_RPC_WS_URL}"
      registry_contract_address: "${REGISTRY_CONTRACT_ADDRESS}"
      ipfs_gateway_url: "${IPFS_GATEWAY_URL}"
      matrix_server_name: "${MATRIX_SERVER_NAME}"
      join_attestation_freshness_seconds: ${JOIN_ATTESTATION_FRESHNESS_SECONDS}
      watcher_backstop_interval_seconds: ${WATCHER_BACKSTOP_INTERVAL_SECONDS}
      membership_registry_path: "${MATRIX_MEMBERSHIP_REGISTRY_PATH}"
      membership_registry_key_path: "${MATRIX_MEMBERSHIP_REGISTRY_KEY_PATH}"
      enforcement_matrix_user_id: "${MATRIX_ENFORCEMENT_USER_ID}"

# Suppress warnings about unrecognized config keys from modules
allow_unknown_config_for_modules: true
