# The step 5.5 end-to-end tooling (test use only): the simulated chain service and the driver.
# Build context: repository root.
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
RUN corepack enable && corepack prepare pnpm@9.6.0 --activate
WORKDIR /repo
# Each pnpm workspace's root files and the packages the e2e tooling needs from it; installs are `--frozen-lockfile` (build-ts-deps.sh)
COPY membership_card_verifier/package.json membership_card_verifier/pnpm-lock.yaml membership_card_verifier/pnpm-workspace.yaml membership_card_verifier/
COPY membership_card_verifier/packages/verifier membership_card_verifier/packages/verifier
COPY membership_card_verifier/packages/verifier-ipfs-provider membership_card_verifier/packages/verifier-ipfs-provider
COPY app-sdk/package.json app-sdk/pnpm-lock.yaml app-sdk/pnpm-workspace.yaml app-sdk/
COPY app-sdk/patches app-sdk/patches
COPY app-sdk/packages/app-sdk app-sdk/packages/app-sdk
COPY wallet-sdk/package.json wallet-sdk/pnpm-lock.yaml wallet-sdk/pnpm-workspace.yaml wallet-sdk/
COPY wallet-sdk/packages/wallet-sdk wallet-sdk/packages/wallet-sdk
COPY sdk-providers-rn/packages/sdk-providers-rn sdk-providers-rn/packages/sdk-providers-rn
COPY sdk-providers-web/packages/sdk-providers-web sdk-providers-web/packages/sdk-providers-web
COPY notary/package.json notary/pnpm-lock.yaml notary/pnpm-workspace.yaml notary/
COPY notary/attestation-ts notary/attestation-ts
COPY notary/deploy/build-ts-deps.sh /build-ts-deps.sh
RUN sh /build-ts-deps.sh
COPY notary/templates/modules notary/templates/modules
COPY notary/templates/aggregate/policy.json notary/templates/aggregate/policy.json
COPY notary/templates/derive/policy.json notary/templates/derive/policy.json
COPY notary/templates/vote-yna/policy.json notary/templates/vote-yna/policy.json
COPY notary/templates/vote/policy.json notary/templates/vote/policy.json
COPY notary/e2e notary/e2e
RUN cd notary && pnpm install --frozen-lockfile --filter "./e2e..."
WORKDIR /repo/notary/e2e
ENV SIM_CHAIN_PORT=8545
CMD ["node", "--experimental-strip-types", "src/sim-chain.ts"]
