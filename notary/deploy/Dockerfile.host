# Notary host image (notary_host.md §3). Build context is the repository root, because the host depends on sibling
# packages through `file:` references (verifier, wallet-sdk):
#   docker build -f notary/deploy/Dockerfile.host -t notary-host .
# Run in the simulator stack (docker-compose.sim.yml, step 5.5); production chain/EAS/Kubo clients are Phase 7.
FROM node:22-slim AS build
RUN corepack enable && corepack prepare pnpm@9.6.0 --activate
WORKDIR /repo
COPY membership_card_verifier/packages/verifier membership_card_verifier/packages/verifier
COPY membership_card_verifier/packages/verifier-ipfs-provider membership_card_verifier/packages/verifier-ipfs-provider
COPY app-sdk/packages/app-sdk app-sdk/packages/app-sdk
COPY notary/attestation-ts notary/attestation-ts
COPY wallet-sdk/packages/wallet-sdk wallet-sdk/packages/wallet-sdk
COPY notary/deploy/build-ts-deps.sh /build-ts-deps.sh
RUN sh /build-ts-deps.sh
COPY notary/host notary/host
RUN cd notary/host && pnpm install --frozen-lockfile=false && pnpm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /repo/notary/host/.output ./.output
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
