# Notary host image (notary_host.md §3). Build context is the repository root, because the host depends on sibling
# packages through `file:` references (verifier, wallet-sdk):
#   docker build -f notary/deploy/Dockerfile.host -t notary-host .
# NOT BUILT OR RUN in step 5.5: needs the integration stack (Phase 7).
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY membership_card_verifier/packages/verifier membership_card_verifier/packages/verifier
COPY wallet-sdk/packages/wallet-sdk wallet-sdk/packages/wallet-sdk
COPY notary/host notary/host
RUN cd membership_card_verifier/packages/verifier && pnpm install --frozen-lockfile=false && pnpm run build
RUN cd wallet-sdk/packages/wallet-sdk && pnpm install --frozen-lockfile=false && pnpm run build
RUN cd notary/host && pnpm install --frozen-lockfile=false && pnpm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /repo/notary/host/.output ./.output
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
