{
  "about": "The aggregate template policy (protocol-objects.md \u00a72.1). A community copies the `notary` section into its policy card and replaces the placeholders: the contributor predicate (the member policy), `program_cid` (the template's CID, see modules/), and the input bounds.",
  "notary": {
    "contributor_predicate": {
      "issued_under_template": "<member policy CID>"
    },
    "input_replacement": "reject_duplicates",
    "input_schema": [
      {
        "name": "value",
        "type": "integer",
        "required": true,
        "description": "The value contributed",
        "min": -1000000000,
        "max": 1000000000
      }
    ],
    "isolation": "shared",
    "job_requester_predicate": {
      "is_holder": true
    },
    "mode": "aggregate",
    "output_action": "statement",
    "output_recipients": {
      "public": true,
      "job_requester": true,
      "cards": []
    },
    "output_schema": [
      {
        "clamp": [
          0,
          100000
        ],
        "description": "Contributors counted",
        "name": "count",
        "required": true,
        "type": "integer"
      },
      {
        "clamp": [
          -1000000000000000,
          1000000000000000
        ],
        "description": "Sum of the values",
        "name": "sum",
        "required": true,
        "type": "integer"
      },
      {
        "clamp": [
          0,
          100000
        ],
        "description": "Contributors in bucket 1 (cells under 5 are omitted)",
        "name": "bucket_1",
        "required": false,
        "suppress_cell_below_k": 5,
        "type": "integer"
      },
      {
        "clamp": [
          0,
          100000
        ],
        "description": "Contributors in bucket 2 (cells under 5 are omitted)",
        "name": "bucket_2",
        "required": false,
        "suppress_cell_below_k": 5,
