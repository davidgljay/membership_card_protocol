{
  "extends": "./.nitro/types/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    ".nitro/types/nitro.d.ts",
    "src/**/*",
    "server/**/*",
    "nitro.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "dist"
  ]
}
