# Base URLs of the live dev deployment these suites run against (stood up
# via scripts/deploy-all.sh dev — see plans/deployment/implementation-plan.md
# Phase 2).
# run.sh sources this file directly (`source .env`), so every value must be
# shell-safe -- no bare < > in a placeholder (bash reads them as
# redirection, not literal text). Replace the whole PLACEHOLDER token below
# with your real value, keeping the quotes.
export DEV_PRESS_URL="https://press-dev.YOUR_ACCOUNT.workers.dev"
export DEV_WALLET_SERVICE_URL="https://wallet-service-dev.YOUR_ACCOUNT.workers.dev"
export DEV_RELAY_URL="https://relay-dev-YOUR_APP_ID.ondigitalocean.app"

# Real Arbitrum Sepolia — NOT a local devnode. No dev_governance_keypair
# exists here (see README.md's "Dev governance prerequisite"); this suite
# set never bootstraps chain state itself.
export DEV_ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
export DEV_REGISTRY_CONTRACT_ADDRESS=
# The Stylus logic contract (separate from the storage contract above) --
# only needed by suites that call it directly (e.g. getProtocolVersion() in
# conformance/ipfs_card.spec.ts). See contracts/deployments/sepolia.json's
# contracts.logic_contract.
export DEV_LOGIC_CONTRACT_ADDRESS=

# Real IPFS gateway (read access only — these suites never pin new content;
# the pre-provisioned policy below is already pinned).
export DEV_IPFS_GATEWAY_URL=https://ipfs.filebase.io

# Bearer token for the dev press's operator-only /api/admin/* endpoints (see
# press/DEPLOYMENT.md's PRESS_ADMIN_API_KEY). Only needed by suites that
# register trusted roots / credit app gas (e.g.
# suites/extended/subcard_creation_policy.spec.ts).
export DEV_PRESS_ADMIN_API_KEY=

# --- Narrower-scoped governance credentials (see
# plans/deployment/dev-governance-rotation-runbook.md) ----------------------
# dev-tests holds all 3 keys of each body's 2-of-3 quorum itself (dev/test-
# only, no cross-party coordination needed). Only needed by
# suites/extended/dns_governance_verifier.spec.ts,
# suites/extended/log_auditing.spec.ts, and
# suites/extended/policy_creation.spec.ts -- every other suite is
# unaffected. Never commit real values; these must be rotated onto the live
# Sepolia deployment first (see the runbook) before they mean anything.
export DEV_TESTS_DNS_GOV_PRIVKEY_1=
export DEV_TESTS_DNS_GOV_PRIVKEY_2=
export DEV_TESTS_DNS_GOV_PRIVKEY_3=
export DEV_TESTS_POLICY_GOV_PRIVKEY_1=
export DEV_TESTS_POLICY_GOV_PRIVKEY_2=
export DEV_TESTS_POLICY_GOV_PRIVKEY_3=

# Ethereum wallet paying gas for the same three suites' raw on-chain writes
# (RegisterDomain/DeregisterDomain/SetDnsGovernancePolicyAddress/
# RegisterPolicy) -- distinct from press/wallet-service's own gas wallets.
# Needs a small amount of real Sepolia ETH.
export DEV_TESTS_GAS_WALLET_PRIVATE_KEY=

# Optional: the shared dev press's own secp256r1 signing key, needed only by
# one specific check in dns_governance_verifier.spec.ts (a press-signed
# SetPolicyAddress write). Body 1 (PressRegistryBody) stays out of
# dev-tests' scope by design, so this is a plain opt-in copy of the same
# secret press/DEPLOYMENT.md's PRESS_SECP256R1_PRIVATE_KEY documents, not a
# new credential -- leave unset to skip that one check.
export DEV_TESTS_PRESS_SECP256R1_PRIVATE_KEY=

# --- Pre-provisioned dev governance (see README.md) -------------------------
# A permissive test policy already registered on-chain, with the dev press
# already authorized under it via a real AuthorizePress governance call.
# scripts/deploy-all.sh / dev-tests never create these -- provisioning is a
# manual, one-time, out-of-band governance action.
export DEV_TESTS_POLICY_ID=
export DEV_TESTS_POLICY_ADDRESS=

# --- relay_data_model conformance test -------------------------------------
# One app_id and one oblivious-target_id already present in the deployed
# relay's real APP_REGISTRY_JSON / OBLIVIOUS_TARGETS_JSON (see
# relay/DEPLOYMENT.md) -- used only to exercise known-vs-unknown-id behavior
# over HTTP; dev-tests has no way to read the relay's config file directly
# (App Platform has no bind mounts -- see relay/DEPLOYMENT.md's "Known
# limitations").
export DEV_RELAY_KNOWN_APP_ID=
export DEV_RELAY_KNOWN_TARGET_ID=

# --- matrix-relay suites (matrix_join_attestation_and_revocation,
# matrix_room_membership, room_discovery) -------------------------------
# A dev Matrix/Synapse deployment, reachable directly (bypassing
# wallet-service's Application Service bridge -- see
# dev-tests/support/matrixAdmin.ts). Per wallet-service/DEPLOYMENT.md's
# "Out of scope" section, Synapse deploys as its own docker-compose
# service, separate from wallet-service's Worker deploy -- confirm this
# exists in dev before filling these in.
export DEV_SYNAPSE_URL=
export DEV_MATRIX_SERVER_NAME=
export DEV_MATRIX_ENFORCEMENT_USER_ID=
export DEV_MATRIX_REGISTRATION_SHARED_SECRET=
